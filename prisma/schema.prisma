generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id              String            @id @default(uuid())
  name            String
  timezone        String            @default("Asia/Dhaka")
  users           User[]
  candidates      Candidate[]
  employees       Employee[]        
  templates       MessageTemplate[]
  payrollSettings PayrollSettings?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  role          Role         @default(HR_STAFF)
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  auditLogs     AuditLog[]
  
  employeeId    String?      @unique
  employee      Employee?    @relation(fields: [employeeId], references: [id])
}

enum Role {
  ADMIN
  HR_MANAGER
  HR_STAFF
  IT_STAFF
}

model Candidate {
  id              String       @id @default(uuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  name            String
  phone           String
  email           String
  position        String
  department      String?
  status          String       @default("NEW") 
  messageStatus   String       @default("NOT_SENT") 
  notes           String?
  customData      Json?
  
  scoreTech       Int?
  scoreComm       Int?
  scoreCulture    Int?
  generalScore    Int?
  evalNotes       String?      
  expectedSalary  String?      
  noticePeriod    String?      

  interview       Interview?
  messageLogs     MessageLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Employee {
  id                   String         @id @default(uuid())
  orgId                String
  organization         Organization   @relation(fields: [orgId], references: [id])
  
  employeeCode         String         @unique 
  name                 String
  email                String?        @unique
  phone                String
  position             String
  department           String
  customData           Json?
  joiningDate          DateTime
  status               String         @default("ACTIVE") 

  // --- PAYROLL & TRANSPORT FIELDS ---
  baseSalary           Float          @default(0)
  usesCompanyTransport Boolean        @default(false)
  transportRouteFare   Float          @default(0)
  mobileBillLimit      Float          @default(0)

  increment            Float          @default(0)
  taxPercentage        Float          @default(0)
  taxAmount            Float          @default(0)
  allowance            Float          @default(0)
  transportAllowance   Float          @default(0)
  
  leaveRequests        LeaveRequest[]
  roomBookings         RoomBooking[]
  itAssets             ITAsset[]
  payrolls             Payroll[]
  loans                Loan[]
  attendances          Attendance[]
  
  user                 User?
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Room {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  capacity    Int
  amenities   Json?
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bookings    RoomBooking[]
}

model RoomBooking {
  id              String    @id @default(uuid())
  
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomName        String    @default("FAL Conference Room")
  
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  teamName        String
  reason          String
  date            DateTime  @db.Date
  startTime       String    
  durationMinutes Int
  status          String    @default("PENDING") 
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Interview {
  id              String    @id @default(uuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date            DateTime  @db.Date
  startTime       String    
  durationMinutes Int
  location        String?
  type            String    @default("IN_PERSON") 
  interviewer     String?
}

model MessageTemplate {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  channel      String       
  subject      String?      
  body         String
  isActive     Boolean      @default(true)
}

model MessageLog {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  channel     String    
  content     String
  status      String    
  provider    String    
  error       String?
  sentAt      DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String   
  entityId    String
  timestamp   DateTime @default(now())
}

// --- LEAVE MANAGEMENT ---

model LeavePolicy {
  id              String   @id @default(cuid())
  orgId           String
  name            String   
  daysPerYear     Int
  isPaid          Boolean  @default(true)
  carryForward    Boolean  @default(false)
  maxCarryForward Int?     @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     String   
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  totalDays     Float    
  reason        String
  status        String   @default("PENDING") 
  reviewerNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// --- IT ASSET MANAGEMENT ---

model ITAsset {
  id            String    @id @default(cuid())
  orgId         String
  name          String    
  category      String    
  serialNumber  String?   
  condition     String    @default("GOOD")      
  status        String    @default("AVAILABLE") 
  location      String?   
  ipAddress     String?   
  specs         Json?     
  credentials   String?   // <--- Add this missing field to match your API route

  assignedToId  String?
  assignedTo    Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// --- GLOBAL PAYROLL SETTINGS & CALENDAR ---

model PayrollSettings {
  id                         String       @id @default(cuid())
  orgId                      String       @unique
  organization               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  // Salary Breakdown Configuration
  basicPercentage            Float        @default(50)  // 50% of Gross
  houseRentPercentageOfBasic Float        @default(50)  // 50% of Basic
  medicalAllowanceFixed      Float        @default(600) // Fixed 600tk
  
  // Salary Cycle Configuration
  salaryCycleStartDay        Int          @default(26)
  salaryCycleEndDay          Int          @default(25)
  weekends                   String[]     @default(["Friday", "Saturday"])
  
  updatedAt                  DateTime     @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  name        String
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  date        DateTime @db.Date
  status      String   // "PRESENT", "ABSENT_UNPAID", "WEEKEND_WORK", "PAID_LEAVE"
  
  @@unique([employeeId, date])
}

// --- LOANS & ADVANCES ---

model Loan {
  id                 String       @id @default(cuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  type               String       @default("COMPANY_LOAN") // COMPANY_LOAN, PRIME_AGRIM_ADVANCE
  totalAmount        Float
  emiAmount          Float        
  remainingBalance   Float
  
  status             String       @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// --- MONTHLY PAYSLIPS ---

model Payroll {
  id                  String   @id @default(cuid())
  
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  month               Int      
  year                Int      
  
  grossSalary         Float    
  basicSalary         Float    
  houseRent           Float    
  medicalAllowance    Float    
  transportAllowance  Float    
  otherAllowances     Float    @default(0)
  
  transportDeduction  Float    @default(0) 
  taxDeduction        Float?   @default(0)
  loanDeduction       Float    @default(0) 
  advanceDeduction    Float    @default(0) 
  leaveDeduction      Float    @default(0) 
  otherDeductions     Float    @default(0)
  payableDays         Float? 
  standardWorkingDays Float?
  
  mobileBillAllocated Float    @default(0) 
  
  netPay              Float    
  
  status              String   @default("DRAFT") // DRAFT, APPROVED, PAID
  paymentDate         DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([employeeId, month, year]) 
}