generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. RBAC & SYSTEM SETTINGS ENUMS
// ==========================================

enum AppModule {
  HR_HUB
  RECRUITMENT
  PAYROLL
  ACCOUNTS
  AUDIT
  RECEPTION
  IT_ASSETS
  SETTINGS
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
}

// ==========================================
// 2. RBAC ACCESS CONTROL
// ==========================================

model Role {
  id          String           @id @default(cuid())
  name        String           @unique 
  description String?
  
  permissions RolePermission[]
  users       User[]           
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id       String           @id @default(cuid())
  roleId   String
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  module   AppModule
  action   PermissionAction
  
  @@unique([roleId, module, action]) 
  @@index([roleId])
}

// ==========================================
// 3. CORE ORGANIZATION & USERS
// ==========================================

model Organization {
  id              String            @id @default(uuid())
  name            String
  timezone        String            @default("Asia/Dhaka")
  
  users           User[]
  candidates      Candidate[]
  employees       Employee[]        
  templates       MessageTemplate[]
  leavePolicies   LeavePolicy[]
  rooms           Room[]
  itAssets        ITAsset[]
  payrollSettings PayrollSettings?
  receptionBills  ReceptionBill[]
  vendors         Vendor[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  roleId       String?
  role         Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  
  employeeId   String?      @unique
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  auditLogs    AuditLog[]

  @@index([orgId])
  @@index([roleId])
}

model Employee {
  id                   String         @id @default(uuid())
  orgId                String
  organization         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  employeeCode         String         @unique 
  name                 String
  email                String?        @unique
  phone                String
  position             String
  department           String
  customData           Json?
  joiningDate          DateTime
  status               String         @default("ACTIVE") 
  bloodGroup           String? 
  gender               String?  

  // Payroll & Transport Constants
  baseSalary           Float          @default(0)
  usesCompanyTransport Boolean        @default(false)
  transportRouteFare   Float          @default(0)
  mobileBillLimit      Float          @default(0)
  increment            Float          @default(0)
  taxPercentage        Float          @default(0)
  taxAmount            Float          @default(0)
  allowance            Float          @default(0)
  transportAllowance   Float          @default(0)
  
  // Relations
  user                 User?
  leaveRequests        LeaveRequest[]
  roomBookings         RoomBooking[]
  itAssets             ITAsset[]
  assetLogs            ITAssetAssignmentLog[] // NEW: History Logger Relation
  payrolls             Payroll[]
  loans                Loan[]
  attendances          Attendance[]

  // Reception 
  receptionBills       ReceptionBill[]
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([orgId])
}

// ==========================================
// 4. RECEPTION & VENDORS
// ==========================================

model Vendor {
  id            String          @id @default(cuid())
  orgId         String?         // Optional for global vendors, required for org-specific
  organization  Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  bills         ReceptionBill[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@index([orgId])
}

model ReceptionBill {
  id              String       @id @default(cuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  systemSerialNo  String       @unique 
  billNumber      String?      
  billDate        DateTime     @db.Date
  entryAt         DateTime     @default(now()) 
  
  category        String       
  amount          Float
  department      String?      
  description     String?      @db.Text 
  
  status          String       @default("DRAFT") 
  discrepancyNote String?      @db.Text

  accountsReceivedAt DateTime?
  auditReceivedAt    DateTime?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  
  vendorId        String
  vendor          Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  
  recordedById    String?
  recordedBy      Employee?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId])
  @@index([systemSerialNo])
  @@index([vendorId])
  @@index([recordedById])
  @@index([status])
}


// ==========================================
// 5. RECRUITMENT (ATS)
// ==========================================

model Candidate {
  id             String         @id @default(uuid())
  orgId          String
  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name           String
  phone          String
  email          String
  position       String
  department     String?
  status         String         @default("NEW") 
  messageStatus  String         @default("NOT_SENT") 
  notes          String?
  customData     Json?
  
  scoreTech      Int?
  scoreComm      Int?
  scoreCulture   Int?
  generalScore   Int?
  evalNotes      String?      
  expectedSalary String?      
  noticePeriod   String?      

  interview      Interview?
  messageLogs    MessageLog[]
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orgId])
  @@index([email])
}

model Interview {
  id              String    @id @default(uuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  date            DateTime  @db.Date
  startTime       String    
  durationMinutes Int
  location        String?
  type            String    @default("IN_PERSON") 
  interviewer     String?

  @@index([date])
}

// ==========================================
// 6. LEAVE MANAGEMENT
// ==========================================

model LeavePolicy {
  id              String         @id @default(cuid())
  orgId           String
  organization    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name            String   
  daysPerYear     Int
  isPaid          Boolean        @default(true)
  carryForward    Boolean        @default(false)
  maxCarryForward Int?           @default(0)
  isActive        Boolean        @default(true)
  
  leaveRequests   LeaveRequest[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orgId])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  policyId      String
  policy        LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  leaveType     String?     
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  totalDays     Float       @default(0)
  reason        String?
  status        String      @default("PENDING") 
  reviewerNotes String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId])
  @@index([policyId])
}

// ==========================================
// 7. IT ASSETS & SPACES
// ==========================================

model ITAsset {
  id           String    @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name         String    
  category     String    
  serialNumber String?   
  condition    String    @default("GOOD")      
  status       String    @default("AVAILABLE") 
  location     String?   
  ipAddress    String?   
  specs        Json?     
  credentials  String?   

  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        String?
  
  // NEW: Relation for the History Logger
  assignmentLogs ITAssetAssignmentLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orgId])
  @@index([assignedToId])
}

// NEW: History Logger Model for IT Assets
model ITAssetAssignmentLog {
  id           String    @id @default(cuid())
  
  assetId      String
  asset        ITAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  action       String    // "ASSIGNED", "RETURNED", "MAINTENANCE"
  notes        String?   @db.Text
  
  performedAt  DateTime  @default(now())

  @@index([assetId])
  @@index([employeeId])
}

model Room {
  id           String        @id @default(cuid())
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name         String
  capacity     Int
  amenities    Json?
  status       String        @default("ACTIVE")
  
  bookings     RoomBooking[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([orgId])
}

model RoomBooking {
  id              String    @id @default(uuid())
  
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomName        String    @default("FAL Conference Room")
  
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  teamName        String
  reason          String
  date            DateTime  @db.Date
  startTime       String    
  durationMinutes Int
  status          String    @default("PENDING") 
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomId])
  @@index([employeeId])
  @@index([date])
}

// ==========================================
// 8. PAYROLL & FINANCE
// ==========================================

model PayrollSettings {
  id                         String       @id @default(cuid())
  orgId                      String       @unique
  organization               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  basicPercentage            Float        @default(50)  
  houseRentPercentageOfBasic Float        @default(50)  
  medicalAllowanceFixed      Float        @default(600) 
  
  salaryCycleStartDay        Int          @default(26)
  salaryCycleEndDay          Int          @default(25)
  weekends                   String[]     @default(["Friday", "Saturday"])
  
  taxFreeAmountMale          Float        @default(400000)
  taxFreeAmountFemale        Float        @default(450000)
  minimumTaxDhaka            Float        @default(5000)
  minimumTaxOther            Float        @default(3000)
  investmentRebatePercentage Float        @default(15)
  allowableInvestmentCap     Float        @default(20) 

  updatedAt                  DateTime     @updatedAt
}

model Payroll {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  month               Int      
  year                Int      
  
  grossSalary         Float    
  basicSalary         Float    
  houseRent           Float    
  medicalAllowance    Float    
  transportAllowance  Float    
  otherAllowances     Float    @default(0)
  
  transportDeduction  Float    @default(0) 
  taxDeduction        Float?   @default(0)
  loanDeduction       Float    @default(0) 
  advanceDeduction    Float    @default(0) 
  leaveDeduction      Float    @default(0) 
  otherDeductions     Float    @default(0)
  
  payableDays         Float? 
  standardWorkingDays Float?
  mobileBillAllocated Float    @default(0) 
  netPay              Float    
  
  status              String   @default("DRAFT") 
  paymentDate         DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([employeeId, month, year]) 
  @@index([employeeId])
}

model Loan {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  type             String   @default("COMPANY_LOAN") 
  totalAmount      Float
  emiAmount        Float        
  remainingBalance Float
  status           String   @default("ACTIVE") 
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([employeeId])
}

// ==========================================
// 9. LOGS & TRACKING
// ==========================================

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  date       DateTime @db.Date
  status     String   
  
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

model MessageTemplate {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  
  name         String
  channel      String        
  subject      String?      
  body         String
  isActive     Boolean      @default(true)

  @@index([orgId])
}

model MessageLog {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  channel     String    
  content     String
  status      String    
  provider    String    
  error       String?
  sentAt      DateTime  @default(now())

  @@index([candidateId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action    String
  entity    String   
  entityId  String
  timestamp DateTime @default(now())

  @@index([userId])
}