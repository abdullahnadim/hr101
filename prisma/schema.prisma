generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id              String            @id @default(uuid())
  name            String
  timezone        String            @default("Asia/Dhaka")
  users           User[]
  candidates      Candidate[]
  employees       Employee[]        // NEW: Link to Employees
  templates       MessageTemplate[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String
  role            Role         @default(HR_STAFF)
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  auditLogs       AuditLog[]
}

enum Role {
  ADMIN
  HR_MANAGER
  HR_STAFF
}

model Candidate {
  id              String       @id @default(uuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  name            String
  phone           String
  email           String
  position        String
  department      String?
  status          String       @default("NEW") 
  messageStatus   String       @default("NOT_SENT") 
  notes           String?
  customData  Json?
  
  scoreTech       Int?
  scoreComm       Int?
  scoreCulture    Int?
  generalScore    Int?
  evalNotes       String?      
  expectedSalary  String?      
  noticePeriod    String?      

  interview       Interview?
  messageLogs     MessageLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// NEW: Independent Employee Model
model Employee {
  id              String         @id @default(uuid())
  orgId           String
  organization    Organization   @relation(fields: [orgId], references: [id])
  
  employeeCode    String         @unique 
  name            String
  email           String?        @unique
  phone           String
  position        String
  department      String
  customData  Json?
  joiningDate     DateTime       // Added field
  status          String         @default("ACTIVE") 
  
  roomBookings    RoomBooking[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// NEW: FAL Conference Room Booking Model
model RoomBooking {
  id              String    @id @default(uuid())
  roomName        String    @default("FAL Conference Room")
  
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  teamName        String
  reason          String
  date            DateTime  @db.Date
  startTime       String    // Format: "14:30"
  durationMinutes Int
  
  // PENDING (Normal), APPROVED, REJECTED, CONFLICT (Overlap - Needs Admin)
  status          String    @default("PENDING") 
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Interview {
  id              String    @id @default(uuid())
  candidateId     String    @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date            DateTime  @db.Date
  startTime       String    
  durationMinutes Int
  location        String?
  type            String    @default("IN_PERSON") 
  interviewer     String?
}

model MessageTemplate {
  id              String       @id @default(uuid())
  orgId           String
  organization    Organization @relation(fields: [orgId], references: [id])
  name            String
  channel         String       
  subject         String?      
  body            String
  isActive        Boolean      @default(true)
}

model MessageLog {
  id              String    @id @default(uuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  channel         String    
  content         String
  status          String    
  provider        String    
  error           String?
  sentAt          DateTime  @default(now())
}

model AuditLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  action          String
  entity          String   
  entityId        String
  timestamp       DateTime @default(now())
}